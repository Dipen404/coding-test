import { useState } from "react";

export default function App() {
  const [todo, setTodo] = useState({
    description: "",
    reportDate: "",
  });

  const [todos, setTodos] = useState([]);
  const [editId, setEditId] = useState(null);
  const [errors, setErrors] = useState({
    description: "",
    reportDate: "",
  });

  const changeHandler = (e) => {
    const { name, value } = e.target;
    setTodo((prev) => ({
      ...prev,
      [name]: value,
    }));
    setErrors((prev) => ({
      ...prev,
      [name]: "", // Clear the error when the user starts typing
    }));
  };

  const validate = () => {
    const newErrors = {};
    if (!todo.description) {
      newErrors.description = "Description is required";
    }
    if (!todo.reportDate) {
      newErrors.reportDate = "Date is required";
    }
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSave = () => {
    if (!validate()) return;

    const newTodo = { id: Date.now(), ...todo };

    if (editId) {
      setTodos((prev) =>
        prev.map((item) =>
          item.id === editId ? { ...item, ...todo } : item
        )
      );
      setEditId(null);
    } else {
      setTodos((prev) => [...prev, newTodo]);
    }

    setTodo({
      description: "",
      reportDate: "",
    });
    setErrors({
      description: "",
      reportDate: "",
    });
  };

  const deleteHandler = (id) => {
    setTodos((prev) => prev.filter((item) => item.id !== id));
  };

  const editHandler = (item) => {
    setEditId(item.id);
    setTodo({
      description: item.description,
      reportDate: item.reportDate,
    });
  };

  return (
    <>
      <h1>Todo Application</h1>

      <label>Description: </label>
      <textarea
        name="description"
        value={todo.description}
        onChange={changeHandler}
      />
      {errors.description && <p style={{ color: "red" }}>{errors.description}</p>}

      <br />
      <br />

      <label>Report Date: </label>
      <input
        type="date"
        name="reportDate"
        value={todo.reportDate}
        onChange={changeHandler}
      />
      {errors.reportDate && <p style={{ color: "red" }}>{errors.reportDate}</p>}

      <br />
      <br />

      <button onClick={handleSave}>
        {editId ? "Update" : "Add"}
      </button>

      <hr />

      {todos.length > 0 && (
        <ul>
          {todos.map((item) => (
            <li key={item.id}>
              <label>Description: {item.description}</label>&nbsp;
              <label>Report Date: {item.reportDate}</label>
              <button onClick={() => deleteHandler(item.id)}>Delete</button>
              <button onClick={() => editHandler(item)}>Edit</button>
            </li>
          ))}
        </ul>
      )}
    </>
  );
}




13. Array.prototype.toString()
Signature: arr.toString()
Returns: String
Description: Returns a string representing the array.

const arr = [1, 2, 'a', '1a'];
console.log(arr.toString()); // "1,2,a,1a"

14. Array.prototype.toLocaleString()
Signature: arr.toLocaleString([locales[, options]])
Returns: String
Description: Returns a localized string representing the array.

const prices = [1234.56, 7890.12];
console.log(prices.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' }));
// "1.234,56 €,7.890,12 €" (may vary based on environment)

15. Array.prototype.indexOf()
Signature: arr.indexOf(searchElement[, fromIndex])
Returns: The first index of the element, or -1 if not found
Description: Returns the first index at which a given element can be found.

const beasts = ['ant', 'bison', 'camel', 'duck', 'bison'];
console.log(beasts.indexOf('bison')); // 1
console.log(beasts.indexOf('bison', 2)); // 4
console.log(beasts.indexOf('giraffe')); // -1

16. Array.prototype.lastIndexOf()
Signature: arr.lastIndexOf(searchElement[, fromIndex])
Returns: The last index of the element, or -1 if not found
Description: Returns the last index at which a given element can be found.

const animals = ['Dodo', 'Tiger', 'Penguin', 'Dodo'];
console.log(animals.lastIndexOf('Dodo')); // 3
console.log(animals.lastIndexOf('Tiger')); // 1

17. Array.prototype.includes()
Signature: arr.includes(valueToFind[, fromIndex])
Returns: Boolean
Description: Determines whether an array includes a certain value.

const arr = [1, 2, 3];
console.log(arr.includes(2)); // true
console.log(arr.includes(4)); // false
console.log(arr.includes(3, 3)); // false

18. Array.prototype.flat()
Signature: arr.flat([depth])
Returns: New array
Description: Creates a new array with all sub-array elements concatenated.

If we do not specify the depth, default depth is 1, Infinity flatten any level of depth
const arr1 = [1, 2, [3, 4]];
console.log(arr1.flat()); // [1, 2, 3, 4]

const arr2 = [1, 2, [3, 4, [5, 6]]];
console.log(arr2.flat(2)); // [1, 2, 3, 4, 5, 6]

const arr = [1, [2, [3, [4, 5]]]];
const flatArr = arr.flat(Infinity);
console.log(flatArr); // [1, 2, 3, 4, 5]


19. Array.prototype.flatMap()
Signature: arr.flatMap(callback(currentValue[, index[, array]])[, thisArg])
Returns: New array
Description: Maps each element using a mapping function, then flattens the result.

const arr = [1, 2, 3, 4];
console.log(arr.flatMap(x => [x * 2])); // [2, 4, 6, 8]
console.log(arr.flatMap(x => [[x * 2]])); // [[2], [4], [6], [8]]

C. Iteration Methods

20. Array.prototype.forEach()
Signature: arr.forEach(callback(currentValue[, index[, array]])[, thisArg])
Returns: undefined
Description: Executes a provided function once for each array element.

const items = ['item1', 'item2', 'item3'];
items.forEach((item, index) => {
  console.log(`${index}: ${item}`);
});
// 0: item1
// 1: item2
// 2: item3

21. Array.prototype.map()
Signature: arr.map(callback(currentValue[, index[, array]])[, thisArg])
Returns: New array
Description: Creates a new array with the results of calling a function on every element.

const numbers = [1, 4, 9];
const roots = numbers.map(num => Math.sqrt(num));
// roots: [1, 2, 3]
// numbers: [1, 4, 9] (unchanged)

22. Array.prototype.filter()
Signature: arr.filter(callback(element[, index[, array]])[, thisArg])
Returns: New array
Description: Creates a new array with all elements that pass the test.

const words = ['spray', 'limit', 'elite', 'exuberant', 'destruction'];
const result = words.filter(word => word.length > 6);
// result: ["exuberant", "destruction"]

23. Array.prototype.reduce()
Signature: arr.reduce(callback(accumulator, currentValue[, index[, array]])[, initialValue])
Returns: Single value
Description: Applies a function against an accumulator and each element to reduce it to a single value.

const sum = [0, 1, 2, 3].reduce(
  (accumulator, currentValue) => accumulator + currentValue,
  0
);
// sum: 6

const flattened = [[0, 1], [2, 3], [4, 5]].reduce(
  (acc, curr) => acc.concat(curr),
  []
);
// flattened: [0, 1, 2, 3, 4, 5]

24. Array.prototype.reduceRight()
Signature: arr.reduceRight(callback(accumulator, currentValue[, index[, array]])[, initialValue])
Returns: Single value
Description: Applies a function against an accumulator and each element (right to left) to reduce it to a single value.

const flattened = [[0, 1], [2, 3], [4, 5]].reduceRight(
  (acc, curr) => acc.concat(curr),
  []
);
// flattened: [4, 5, 2, 3, 0, 1]

25. Array.prototype.find()
Signature: arr.find(callback(element[, index[, array]])[, thisArg])
Returns: The first element that satisfies the condition, or undefined
Description: Returns the first element in the array that satisfies the testing function.

const inventory = [
  {name: 'apples', quantity: 2},
  {name: 'bananas', quantity: 0},
  {name: 'cherries', quantity: 5}
];
const result = inventory.find(fruit => fruit.name === 'cherries');
// result: { name: 'cherries', quantity: 5 }

26. Array.prototype.findIndex()
Signature: arr.findIndex(callback(element[, index[, array]])[, thisArg])
Returns: The index of the first element that satisfies the condition, or -1
Description: Returns the index of the first element in the array that satisfies the testing function.

const array1 = [5, 12, 8, 130, 44];
const isLargeNumber = (element) => element > 13;
console.log(array1.findIndex(isLargeNumber)); // 3

27. Array.prototype.every()
Signature: arr.every(callback(element[, index[, array]])[, thisArg])
Returns: Boolean
Description: Tests whether all elements in the array pass the test.

const isBelowThreshold = (currentValue) => currentValue < 40;
const array1 = [1, 30, 39, 29, 10, 13];
console.log(array1.every(isBelowThreshold)); // true

28. Array.prototype.some()
Signature: arr.some(callback(element[, index[, array]])[, thisArg])
Returns: Boolean
Description: Tests whether at least one element in the array passes the test.

const array = [1, 2, 3, 4, 5];
const even = (element) => element % 2 === 0;
console.log(array.some(even)); // true

D. Iterator Methods

29. Array.prototype.keys()
Signature: arr.keys()
Returns: A new Array Iterator object
Description: Returns a new Array Iterator that contains the keys for each index in the array.

const arr = ['a', 'b', 'c'];
const iterator = arr.keys();

for (const key of iterator) {
  console.log(key); // 0, 1, 2
}

30. Array.prototype.values()
Signature: arr.values()
Returns: A new Array Iterator object
Description: Returns a new Array Iterator object that contains the values for each index in the array.

const arr = ['a', 'b', 'c'];
const iterator = arr.values();

for (const value of iterator) {
  console.log(value); // 'a', 'b', 'c'
}

31. Array.prototype.entries()
Signature: arr.entries()
Returns: A new Array Iterator object
Description: Returns a new Array Iterator object that contains the key/value pairs for each index in the array.

const arr = ['a', 'b', 'c'];
const iterator = arr.entries();

for (const [index, element] of iterator) {
  console.log(index, element);
}
// 0 'a'
// 1 'b'
// 2 'c'

E. Static Methods

32. Array.from()
Signature: Array.from(arrayLike[, mapFn[, thisArg]])
Returns: New Array instance
Description: Creates a new Array instance from an array-like or iterable object.

console.log(Array.from('foo')); // ['f', 'o', 'o']
console.log(Array.from([1, 2, 3], x => x + x)); // [2, 4, 6]

33. Array.isArray()
Signature: Array.isArray(value)
Returns: Boolean
Description: Determines whether the passed value is an Array.

console.log(Array.isArray([1, 2, 3])); // true
console.log(Array.isArray({foo: 123})); // false

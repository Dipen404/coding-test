41. Rotate array right
function rotateRight(array, rotateBy){
    rotateBy=rotateBy%array.length;
    if(rotateBy===0) return array.slice();
    return array.slice(-rotateBy).concat(array.slice(0,array.length-rotateBy))
}

42. Rotate array left
function rotateLeft(array, rotateBy){
    rotateBy=rotateBy%array.length;
    if(rotateBy===0) return array.slice();
    return array.slice(rotateBy).concat(array.slice(0,rotateBy))
}